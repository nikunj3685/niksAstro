<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <!-- Aladin's HiPS "properties" files have no extension; IIS 404s unmapped
           extensions by default (including "no extension at all"), which broke
           the local tile cache's reachability probe and Aladin's own internal
           CORS check against it. -->
      <mimeMap fileExtension="." mimeType="text/plain" />
    </staticContent>
  </system.webServer>
</configuration>
